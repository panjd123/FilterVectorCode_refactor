{
  "run_name": "lng_special_blocks_compare",
  "output_layout": "index_by_dataset",
  "data_root": "/home/dev/graphdb/FilterVectorData",
  "result_root": "/home/dev/graphdb/FilterVectorResult",
  "build_dir": "/home/dev/graphdb/FilterVectorCode_refactor/build_ung_rel",
  "selector_model_prefix": "/home/dev/graphdb/FilterVectorResult/SelectModels",
  "datasets": [
    {
      "dataset": "Amazon",
      "query_task": "query_selected_recall_advantage"
    }
  ],
  "build": {
    "data_type": "float",
    "dist_fn": "L2",
    "scenario": "general",
    "num_threads": 60,
    "max_degree": 32,
    "Lbuild": 100,
    "alpha": 1.2,
    "num_cross_edges": 4
  },
  "search": {
    "K": 10,
    "num_repeats": 1,
    "num_threads": 100,
    "num_entry_points": 16,
    "lsearch_start": 1000,
    "lsearch_end": 20000,
    "lsearch_step": 1000,
    "efs_start": 10,
    "efs_step_slow": 10,
    "efs_step_fast": 10,
    "lsearch_threshold": 1000,
    "entry_group_provider": "cpu_bruteforce_els",
    "force_use_alg": 1
  },
  "common_ung_env": {
    "UNG_BUILD_PROFILE": "custom",
    "UNG_GROUP_GRAPH_IMPL": "0",
    "UNG_GET_MIN_SUPER_SETS_IMPL": "0",
    "UNG_LNG_IMPL": "1",
    "UNG_DESCENDANTS_IMPL": "1",
    "UNG_COVERAGE_IMPL": "0",
    "UNG_CROSS_EDGE_IMPL": "0",
    "UNG_ADDITIONAL_EDGES_IMPL": "0",
    "UNG_GROUP_GRAPH_COMPLETE_NX": "64",
    "UNG_GROUP_GRAPH_BOUNDED_COMPLETE": "0",
    "UNG_SPECIAL_BLOCKS": "1",
    "UNG_SPECIAL_BLOCK_DATA_MODE": "x1",
    "UNG_SPECIAL_BLOCK_SKIP_TRIVIAL": "1",
    "UNG_SPECIAL_BLOCK_MIN_POINTS": "1000",
    "UNG_SPECIAL_INTRA_COMPLETE_NX": "1024",
    "UNG_SPECIAL_INTRA_EXACT_TOPK": "1",
    "UNG_SPECIAL_INTRA_BOUNDED_COMPLETE": "1",
    "UNG_SPECIAL_INTER_MAX_PAIR_WORK": "0",
    "UNG_SPECIAL_BLOCK_MAX_DEGREE": "128",
    "UNG_SPECIAL_BLOCK_NUM_CROSS_EDGES": "10"
  },
  "methods": [
    {
      "name": "trie_special_blocks",
      "index_name": "UNG_special_blocks_hybrid",
      "ung_env": {
        "UNG_SPECIAL_BLOCK_PARTITION": "trie"
      },
      "search_env": {
        "UNG_SPECIAL_BLOCK_SEARCH": "1"
      }
    },
    {
      "name": "lng_special_blocks_bfs",
      "index_name": "UNG_lng_special_blocks_hybrid_bfs",
      "ung_env": {
        "UNG_SPECIAL_BLOCK_PARTITION": "lng",
        "UNG_SPECIAL_BLOCK_TREE_MODE": "bfs",
        "UNG_SPECIAL_BLOCK_TREE_SEED": "1"
      },
      "search_env": {
        "UNG_SPECIAL_BLOCK_SEARCH": "1"
      }
    },
    {
      "name": "lng_special_blocks_random_seed1",
      "index_name": "UNG_lng_special_blocks_hybrid_random_s1",
      "ung_env": {
        "UNG_SPECIAL_BLOCK_PARTITION": "lng",
        "UNG_SPECIAL_BLOCK_TREE_MODE": "random",
        "UNG_SPECIAL_BLOCK_TREE_SEED": "1"
      },
      "search_env": {
        "UNG_SPECIAL_BLOCK_SEARCH": "1"
      }
    }
  ],
  "steps": {
    "build_indexes": true,
    "run_search": true,
    "compute_groundtruth_if_missing": true,
    "convert_query_fvecs_if_missing": true
  },
  "build_tools": {
    "policy": "if_stale",
    "jobs_env": "BUILD_JOBS"
  }
}
