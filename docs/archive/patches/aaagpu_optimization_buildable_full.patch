+extern "C" __global__ void ung_group_desc_topk_fused_global_kernel(
+    const UngGroupQueryDesc* __restrict__ descs, // [num_desc]
+    int num_desc,
+    const float* __restrict__ Q,                 // [total_queries, dim]
